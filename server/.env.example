# =============================================================================
# Corporate RAG AI-Agent Server — environment example
# Copy to server/.env for local runs. Never commit real secrets.
# Keys here match Settings fields.
# =============================================================================

# --- App ---------------------------------------------------------------------
# APP_HOST / APP_PORT: for uvicorn (e.g. source .env && uvicorn ... --host $APP_HOST)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
AUTH_MODE=none
# AUTH_MODE=header → require X-User-Id / X-Officer-Token placeholders
# AUTH_OFFICER_TOKEN=change-me

# --- Docs corpus (local-only; gitignored under server/docs by default) -------
# Directory of regulation .docx (and related) files for ingest. Not committed.
DOCS_CORPUS_PATH=docs
# Optional alias (overrides DOCS_CORPUS_PATH when set):
# DOCS_DIR=/absolute/or/relative/path/to/corpus

# --- Persistence (PostgreSQL is the system of record) -----------------------
# Appeals, messages, escalations, audit, stats must survive restarts.
DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5432/rag_agent
# Optional emergency local-only fallback (not the prototype target):
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_S=30
DATABASE_ECHO=false

# --- LLM (OpenAI-compatible chat completions) --------------------------------
# LLM_BASE_URL without trailing /chat/completions
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=180
# LLM_REASONING_TOKENS добавляется к LLM_MAX_TOKENS в запросе
# (бюджет reasoning/chain-of-thought + текст ответа → поле max_tokens).
LLM_REASONING_TOKENS=1024

# --- Embeddings (OpenAI-compatible /embeddings, dense + sparse bge-m3) -------
# Sparse: try EMBEDDINGS_SPARSE_MODEL via /embeddings; on failure or dense-only
# payload, fall back to local token→weight map (Qdrant sparse indices via CRC32).
EMBEDDINGS_BASE_URL=https://example.invalid/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_DENSE_MODEL=bge-m3-dense
EMBEDDINGS_SPARSE_MODEL=bge-m3-sparse
EMBEDDINGS_DENSE_DIM=1024
EMBEDDINGS_BATCH_SIZE=32
EMBEDDINGS_TIMEOUT_S=120

# --- Qdrant ------------------------------------------------------------------
# Local Qdrant: use http://127.0.0.1:6333 (REST on 6333).
# Qdrant Cloud: use https://<cluster-id>.<region>.cloud.qdrant.io:443 (HTTPS on port 443).
# Do not point Cloud clusters at :6333 — that port is for local/self-hosted only.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Logical alias; physical collections e.g. corp_regs_v1 / corp_regs_v2 (blue/green)
QDRANT_COLLECTION=corp_regs
QDRANT_TIMEOUT_S=60
QDRANT_UPSERT_BATCH=64

# --- Docling -----------------------------------------------------------------
# Convert via Docling Serve; then HybridChunker-style windows (max/overlap/min).
DOCLING_BASE_URL=https://example.invalid/docling
DOCLING_API_KEY=
DOCLING_TIMEOUT_S=300
DOCLING_CONNECT_TIMEOUT_S=30
DOCLING_CONCURRENCY=2
DOCLING_SPLIT_PAGES=true
DOCLING_OCR_LANGS=ru,en
DOCLING_CHUNKER=HybridChunker
DOCLING_CHUNK_TOKENIZER=BAAI/bge-m3
DOCLING_CHUNK_MAX_TOKENS=512
DOCLING_CHUNK_OVERLAP_TOKENS=64
DOCLING_CHUNK_MIN_TOKENS=32

# --- LibreOffice / soffice ---------------------------------------------------
LIBREOFFICE_SOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_S=120

# --- Rerank ------------------------------------------------------------------
# none = vector order (+ prefer-latest); llm = LLM reorders candidates before answer.
RERANK_MODE=none
# RERANK_MODE=llm|none
RERANK_LLM_MODEL=
RERANK_CANDIDATES=20
RERANK_TOP_K=5
RERANK_MAX_PER_DOC=3
RERANK_MIN_SCORE=0.0

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_PREFETCH=50
RETRIEVAL_PREFER_LATEST=true
# Blend vector score with lexical overlap (0..1). Helps demote mid-chunk noise.
RETRIEVAL_LEXICAL_WEIGHT=0.35

# --- Abbreviation glossary ---------------------------------------------------
# Built-in corporate list (РП, АМ, ТЗ, …) is used by default for:
#   - query expansion before hybrid search
#   - ingest: append expansions into chunk TEXT (so dense/sparse embed them)
#     and tag payload metadata.abbreviations
# Override / extend with ABBR=expansion pairs (`;` `|` or newlines):
# ABBREVIATION_GLOSSARY=РП=Руководитель проекта;АМ=Аккаунт-менеджер
# Or load from a file (merged on top of defaults when ABBREVIATION_USE_DEFAULTS=true):
# ABBREVIATION_GLOSSARY_PATH=/path/to/glossary.txt
ABBREVIATION_USE_DEFAULTS=true
ABBREVIATION_EXPAND_QUERY=true
ABBREVIATION_ENRICH_INGEST=true

# --- Dialogue / grounding ----------------------------------------------------
DIALOGUE_MAX_CLARIFY_TURNS=3
GROUNDING_MIN_CITATIONS=1
GROUNDING_MIN_SCORE=0.0
# Extra in-domain topics beyond corporate regulations (domain gate / classify / refuse).
# Corporate regs are always allowed. Add labels (and optional descriptions) for other
# corpora AFTER ingesting those docs into Qdrant. Separators: `;` `|` or newlines.
# Entry forms: `Label` or `Label=description` or `Label: description`.
# Example (Конституция РФ + ТК РФ):
# ALLOWED_TOPICS=Конституция РФ=основной закон РФ;Трудовой кодекс РФ=трудовые отношения
# Weather / time / jokes stay refused regardless of this list.
# ALLOWED_TOPICS=

# --- Quality escalation ------------------------------------------------------
QUALITY_SERVICE_EMAIL=quality@example.invalid
ESCALATION_ENABLED=true
ESCALATION_EMAIL_SUBJECT_PREFIX=[RAG-Escalation]

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUEST_BODY=false
LOG_REDACT_SECRETS=true
LOG_CORRELATION_HEADER=X-Request-Id

# --- Optional egress allowlist (comma-separated hosts) -----------------------
# EGRESS_ALLOW_HOSTS=llm.internal,embeddings.internal,qdrant.internal,docling.internal

# --- Tests -------------------------------------------------------------------
# Default `pytest` runs unit/contract tests with mocks.
# Integration/e2e markers run when services answer ping via Settings URLs above;
# otherwise they skip. Examples (from server/):
#   pytest
#   pytest -m integration
#   pytest -m e2e
#   rag-server check
